#!/usr/bin/env python3
"""
🦞 NexusOS Linux CLI Version
简单、方便的命令行工具
"""

import sys
import os

# 添加NexusOS核心路径
NEXUSOS_CORE = os.path.expanduser("~/.nexusos/core")

VERSION = "1.0.0"
NAME = "NexusOS Linux CLI"

def print_banner():
    """打印横幅"""
    print("""
╔═══════════════════════════════════════════════════════════╗
║                                                           ║
║   🦞 NexusOS Linux CLI v1.0                            ║
║   简单 • 方便 • 快速                                     ║
║                                                           ║
╚═══════════════════════════════════════════════════════════╝
""")

def print_help():
    """打印帮助"""
    print("""
用法: nexusos [命令] [参数]

命令:
  start         启动NexusOS服务
  stop          停止NexusOS服务
  status        查看服务状态
  restart       重启服务
  log           查看日志
  config        配置管理
  
  ask           提问问题
  chat          交互式对话
  learn         开启实时学习
  
  plugin        插件管理
  task          任务管理
  
  version       显示版本
  help          显示帮助

示例:
  nexusos start              # 启动服务
  nexusos ask 你好          # 提问
  nexusos status            # 查看状态
  nexusos plugin list       # 列出插件
  nexusos task create       # 创建任务
""")

def cmd_start(args):
    """启动服务"""
    print("🚀 启动NexusOS服务...")
    os.system("python3 ~/.nexusos/nexusos/nexusos_v2.py &")
    print("✅ 服务已启动")

def cmd_stop(args):
    """停止服务"""
    print("🛑 停止NexusOS服务...")
    os.system("pkill -f nexusos_v2.py")
    print("✅ 服务已停止")

def cmd_status(args):
    """查看状态"""
    result = os.popen("ps aux | grep nexusos_v2.py | grep -v grep").read()
    if result:
        print("✅ NexusOS正在运行")
        print(result)
    else:
        print("❌ NexusOS未运行")

def cmd_ask(args):
    """提问"""
    if not args:
        print("❌ 请输入问题")
        return
    
    question = " ".join(args)
    print(f"❓ 问题: {question}")
    print("🤔 思考中...")
    # 这里调用NexusOS API
    print("💡 答案: (请先启动服务)")

def cmd_version(args):
    """显示版本"""
    print(f"🦞 {NAME} v{VERSION}")

def main():
    """主函数"""
    if len(sys.argv) < 2:
        print_banner()
        print_help()
        return
    
    cmd = sys.argv[1]
    args = sys.argv[2:]
    
    commands = {
        "start": cmd_start,
        "stop": cmd_stop,
        "status": cmd_status,
        "restart": lambda a: (cmd_stop(a), cmd_start(a)),
        "ask": cmd_ask,
        "version": cmd_version,
        "help": lambda a: print_help(),
        "-h": lambda a: print_help(),
        "--help": lambda a: print_help(),
    }
    
    if cmd in commands:
        commands[cmd](args)
    else:
        print(f"❌ 未知命令: {cmd}")
        print_help()

if __name__ == "__main__":
    main()
